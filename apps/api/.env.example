# Copy to .env. Never commit real values.

# Existing Azure PostgreSQL (the DB is KEPT from the .NET stack).
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wardyou_dev?schema=public

# JWT — the Node API mints its OWN tokens (independent of the .NET key). For
# production, generate a strong key and set it as an App Service / container env var:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-at-least-32-characters
JWT_ISSUER=Wityu
JWT_AUDIENCE=Wityu.App
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Google OAuth (web client) — used by the server-side social login flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

PORT=3000
# Comma-separated allowed origins. Add the production web/app domains for prod.
CORS_ORIGIN=http://localhost:8081
