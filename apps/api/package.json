{
  "name": "@wardyou/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WardYou API (Caminho B — Node/TypeScript over the existing Azure PostgreSQL).",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && cd dist && node --env-file=../.env --test",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.0",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.2.0",
    "google-auth-library": "^10.9.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
