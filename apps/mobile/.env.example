# Copy to .env and fill in. Never commit real values.

# Backend API (Phase 4). For dev, point to the local Node API or the Azure URL.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Google Maps — native SDK keys (used at prebuild/build time)
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Google Maps — JS API key for the web preview (restrict by HTTP referrer)
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# Social login (Phase 4)
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
