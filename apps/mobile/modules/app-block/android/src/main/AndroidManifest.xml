<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Special permission granted by the user via Settings → Usage access. Lets
       the child device read its own per-app foreground time for the daily limit. -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- See all installed apps (Android 11+ package visibility) so the child can
       list its apps for the guardian and the blocker can resolve the launcher/
       dialer to keep them usable. Allowed for parental-control apps (needs the
       Play Console declaration at submission). -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
  <!-- "Shield" keep-alive foreground service: keeps the process at foreground
       priority while enforcement is on, so OEM task killers (MIUI etc.) don't
       kill the app and silently disable the AccessibilityService. specialUse
       is the honest FGS type for parental-control protection (Android 14+).
       MUST run in the app's DEFAULT process — see the fix note on the
       <service> below; this permission block is unchanged either way. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- Lets the watchdog's AlarmManager tick use setExactAndAllowWhileIdle() as a
       genuinely exempt exact alarm instead of falling back to an inexact one.
       This matters specifically for AppBlockShieldService.start()'s
       startForegroundService() call made from AppBlockBootReceiver: Android 12+
       refuses to start a foreground service from a plain background broadcast
       receiver UNLESS the triggering event is on the documented exemption list
       (developer.android.com "Restrictions on starting a foreground service
       from the background") — "your app invokes an exact alarm" is on that
       list, a bare AlarmManager.set() is not. Confirmed on-device (Redmi Note
       10, Android 12, 2026-09-11) via dumpsys dropbox: without this permission
       declared, setExactAndAllowWhileIdle() throws SecurityException, the code
       falls back to the inexact am.set(), and the resulting tick's
       startForegroundService() is DENIED ("Background started FGS: Disallowed
       ... code:DENIED"), so the watchdog can never resurrect the shield after
       a process kill. On API 31-32 this permission is auto-granted at install
       (no user-visible prompt) just by declaring it; on API 33+ it additionally
       needs Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM — see
       AppBlockModule.canScheduleExactAlarms()/requestScheduleExactAlarm(),
       exposed for the JS layer to prompt for (a visible ask — founder call on
       whether/when to surface it, not wired into any flow by this change). -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- Battery-optimization exemption request (Settings dialog) — parental
       protection must survive Doze/OEM battery savers on the child's device. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- Fallback path for the "app blocked" panel: the primary is the
       accessibility overlay (no permission), but some OEM builds suppress it —
       SYSTEM_ALERT_WINDOW lets us draw an application overlay instead so the
       panel always appears the instant a blocked app is opened. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Last-resort path for the blocked panel: a full-screen-intent notification
       (the incoming-call mechanism) can present UI from the background even
       where OEMs suppress overlays and plain startActivity. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <application>
    <service
      android:name=".AppBlockAccessibilityService"
      android:exported="true"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
      android:label="@string/app_block_service_label">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/app_block_accessibility_service_config" />
    </service>
    <!-- FIXED 2026-09-11 (field bug, Redmi Note 10/Android 12): this used to
         declare android:process=":shield" on the theory that a separate
         process would survive a recents swipe even if the app's main process
         died. That protected the WRONG process: AppBlockAccessibilityService
         (below) has never declared a process, so it has always run in the
         app's DEFAULT process — the one actually enforcing. Keeping only
         ":shield" alive after "fechar todos" left the enforcement-hosting
         process with no foreground-priority protection at all; confirmed via
         `logcat -b events` showing BOTH `com.wardyou.app` and
         `com.wardyou.app:shield` killed one second apart by MIUI's
         "SwipeUpClean". Standard fix (same pattern music-player FGS's use):
         no android:process here, so this FGS's stopWithTask="false" now keeps
         the app's DEFAULT process alive — the one hosting the
         AccessibilityService, the Expo/RN bridge, and AppBlockModule's
         `instance` static that the JS bridge reads. Do not re-add a separate
         process without also moving BIND_ACCESSIBILITY_SERVICE and reworking
         AppBlockModule's cross-process access (instance/EventBus are same-
         process assumptions throughout this module). -->
    <service
      android:name=".AppBlockShieldService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Parental-control protection keep-alive: keeps the app-blocking enforcement process alive while a guardian's policy is active on a child device." />
    </service>
    <!-- Anti-theft siren FGS: see AppBlockSirenService.kt for why this is a
         SEPARATE service from AppBlockShieldService above (must keep sounding
         even for a device that never enabled parental app-blocking — e.g. an
         elder-care device using only antifurto/SOS) and why specialUse (no
         MediaSession/MediaStyle — a lock-screen "pause" control would hand
         the thief a way to silence it). Reuses the FOREGROUND_SERVICE_SPECIAL_USE
         permission already declared above; no new permission needed. -->
    <service
      android:name=".AppBlockSirenService"
      android:exported="false"
      android:stopWithTask="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Anti-theft alarm: plays an audible siren on STREAM_ALARM until the device owner authenticates, so a thief closing or swiping away the app cannot silence it." />
    </service>
    <!-- Device admin: while active, Android REFUSES to uninstall the app — the
         fix for a child long-pressing the icon and tapping "Desinstalar".
         Policies are minimal (force-lock only; no wipe, no password control). -->
    <receiver
      android:name=".AppBlockDeviceAdminReceiver"
      android:exported="true"
      android:label="@string/app_block_admin_label"
      android:description="@string/app_block_admin_description"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/app_block_device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
        <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
      </intent-filter>
    </receiver>
    <receiver
      android:name=".AppBlockBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <!-- Watchdog tick (AlarmManager): restarts the shield if the process
             was killed while the guardian had the app closed. -->
        <action android:name="com.wardyou.app.APPBLOCK_WATCHDOG" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
