{
  "name": "wardyou",
  "version": "0.1.0",
  "private": true,
  "description": "WardYou — family safety platform. Monorepo: Expo mobile client + Node API (added in phase 4).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @wardyou/mobile",
    "mobile:web": "npm run web --workspace @wardyou/mobile",
    "mobile:android": "npm run android --workspace @wardyou/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @wardyou/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true
  }
}
